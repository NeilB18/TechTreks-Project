# Copy to .env (never commit .env) and fill in.

# Qwen (Alibaba Cloud Model Studio; key and endpoint must be from the same region)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=            # https://<API Host from Workspace Management>/compatible-mode/v1

# Django backend
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=        # required when DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
AGENT_API_TOKEN=          # shared secret between the agent/bot and the API (dev default: dev-agent-token)
DATABASE_URL=             # empty = local SQLite; Supabase Postgres connection string later

# GroupMe bot (backend/bot)
GROUPME_CALLBACK_SECRET=  # random string; callback URL is https://<host>/groupme/callback/<secret>
BOT_DM_MODE=store         # store = private notices on the trip page; groupme = DM API (after the spike works)
GROUPME_ACCESS_TOKEN=     # only for BOT_DM_MODE=groupme: token of the account that sends DMs
BOT_MENTION=@tripbot
BOT_FORWARD_ALL=0         # 1 = also send un-mentioned messages to the agent

# Google sign-in (docs/google-signin.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

# Real travel data (optional; without these, tips and itineraries use built-in sample data)
GOOGLE_PLACES_API_KEY=    # Google Cloud console -> enable "Places API (New)" -> Credentials -> API key
SERPAPI_KEY=              # serpapi.com -> sign up -> API key (hotel prices; free tier ~100 searches/month)
